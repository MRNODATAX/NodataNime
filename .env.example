# ==========================================
# Konfigurasi Produksi NodataNime
# Salin file ini menjadi `.env` saat deploy (Opsional — berjalan tanpa env var di Vercel)
# ==========================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Direktori penyimpanan persisten untuk Obrolan Komunitas (Opsional)
# Di Vercel Serverless otomatis beralih ke /tmp/nodatanime-data
DATA_DIR=./data

# Endpoint Sumber Scraper (Opsional bila domain sumber berubah)
YLNIME_BASE_URL=https://ylnime.com
ANIMEKITA_BASE_URL=https://apps.animekita.org/api/v1.2.5
