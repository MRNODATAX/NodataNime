# ==========================================
# Konfigurasi Produksi NodataNime
# Salin file ini menjadi `.env` saat deploy
# ==========================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Kredensial Studio Admin (/admin) — WAJIB diganti saat produksi!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat_anda_2026
ADMIN_SESSION_SECRET=ganti_kunci_acak_panjang_minimal_32_karakter_2026

# Direktori penyimpanan persisten untuk Admin Vault & Obrolan Komunitas
# Contoh di Docker/Render/Railway dengan Volume: /var/data
DATA_DIR=./data

# Endpoint Sumber Scraper (Opsional bila domain sumber berubah)
YLNIME_BASE_URL=https://ylnime.com
ANIMEKITA_BASE_URL=https://apps.animekita.org/api/v1.2.5
